{
    "permissions": {
        "allow": [
            "Read",
            "Edit",
            "Write",
            "Bash(ls:*)",
            "Bash(pwd)",
            "Bash(composer install)",
            "Bash(composer dump-autoload:*)",
            "Bash(php:*)",
            "Bash(./vendor/bin/phpunit:*)",
            "Bash(phpunit:*)",
            "Bash(./vendor/bin/pest:*)",
            "Bash(./vendor/bin/phpstan:*)",
            "Bash(./vendor/bin/php-cs-fixer:*)",
            "Bash(php artisan test:*)",
            "Bash(php artisan route:list)",
            "Bash(php artisan cache:clear)",
            "Bash(git status)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git add:*)",
            "Bash(git commit:*)",
            "Bash(git checkout:*)",
            "Bash(git branch:*)"
        ],
        "ask": [
            "Bash(composer require:*)",
            "Bash(composer update:*)",
            "Bash(composer remove:*)",
            "Bash(php artisan migrate:*)",
            "Bash(php artisan db:*)",
            "Bash(php artisan tinker:*)",
            "Bash(git push:*)",
            "Bash(git reset:*)",
            "Bash(docker:*)",
            "Bash(docker-compose:*)",
            "WebFetch"
        ],
        "deny": [
            "Read(.env)",
            "Read(.env.*)",
            "Read(**/.env)",
            "Read(**/.env.*)",
            "Read(auth.json)",
            "Read(**/auth.json)",
            "Read(**/*.pem)",
            "Read(**/*.key)",
            "Read(**/id_rsa*)",
            "Read(**/id_ed25519*)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Bash(rm -rf:*)",
            "Bash(sudo:*)",
            "Bash(chmod -R:*)",
            "Bash(curl:*)",
            "Bash(wget:*)",
            "Bash(ssh:*)",
            "Bash(scp:*)",
            "Bash(git push --force:*)",
            "Bash(php artisan migrate:fresh:*)",
            "Bash(cat .env*)",
            "Bash(cat:*env*)"
        ]
    }
}
